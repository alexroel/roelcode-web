---
import { Icon } from "astro-icon/components";
import SocialLinks from "@/components/utils/SocialLinks.astro";
import ModeToggle from "@/components/utils/ModeToggle.astro";

import logoRC from "@/assets/logo-roelcode.svg";
import { Image } from "astro:assets";

// Lista de navegación
const navigationItems = [
  { name: "Inicio", link: "/", external: false },
  { name: "Cursos", link: "/cursos", external: false },
  { name: "Acerca de", link: "/acerca-de", external: false },
  {
    name: "Udemy",
    link: "https://www.udemy.com/user/alex-roel/",
    external: true,
  },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 glass-dark border-b border-slate-700/50"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center space-x-2 group">
          <Image src={logoRC} alt="RoelCode" class="h-8 w-auto" />
          <span
            class="text-xl font-bold text-white group-hover:text-gradient-cyan transition-all"
            >RoelCode</span
          >
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex space-x-2">
        {
          navigationItems.map((item) => (
            <a
              href={item.link}
              target={item.external ? "_blank" : "_self"}
              class="relative px-4 py-2 text-sm font-medium text-slate-300 hover:text-white transition-colors group"
            >
              {item.name}
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-cyan-500 to-emerald-500 group-hover:w-3/4 transition-all duration-300" />
              {item.external && (
                <Icon
                  name="arrow-line-right"
                  class="inline-block w-3 h-3 ml-1 opacity-50"
                />
              )}
            </a>
          ))
        }
      </nav>

      <!-- Right side: Theme toggle + Social links + Mobile menu -->
      <div class="flex items-center space-x-4">
        <!-- Theme Toggle -->
        <ModeToggle />

        <!-- Social Links (solo en desktop) -->
        <div class="hidden lg:flex">
          <SocialLinks variant="header" />
        </div>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-button"
          class="lg:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-colors"
        >
          <Icon name="menu" class="h-6 w-6" />
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="lg:hidden hidden border-t border-slate-700/50">
      <div class="px-2 pt-4 pb-4 space-y-1">
        {
          navigationItems.map((item) => (
            <a
              href={item.link}
              target={item.external ? "_blank" : "_self"}
              class="block px-4 py-3 text-base font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors"
            >
              {item.name}
              {item.external && (
                <Icon
                  name="arrow-line-right"
                  class="inline-block w-4 h-4 ml-2 opacity-50"
                />
              )}
            </a>
          ))
        }

        <!-- Mobile Social Links -->
        <div class="pt-4 border-t border-slate-700/50 mt-4">
          <SocialLinks variant="mobile" />
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16"></div>

<script>
  // Mobile menu functionality
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  mobileMenuButton?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
