---
import StatsCard from "@/components/utils/StatsCard.astro";
import { stats } from "@/data/stats";
import { Icon } from "astro-icon/components";
---

<section class="relative py-20 lg:py-28 bg-slate-950 overflow-hidden">
  <!-- Background Effects -->
  <div
    class="absolute top-0 left-1/4 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-0 right-1/4 w-80 h-80 bg-violet-500/5 rounded-full blur-3xl"
  >
  </div>

  <div class="relative container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center px-4 py-2 glass rounded-full text-sm font-medium mb-6 border border-cyan-500/30"
      >
        <Icon name="star" class="w-4 h-4 text-cyan-400 mr-2" />
        <span class="text-cyan-300">Números que Hablan</span>
      </div>
      <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">
        Mi <span class="text-gradient-cyan">Experiencia</span>
      </h2>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        stats.map((stat) => (
          <StatsCard
            name={stat.name}
            description={stat.description}
            value={stat.value}
            icon={stat.icon}
          />
        ))
      }
    </div>
  </div>
</section>
