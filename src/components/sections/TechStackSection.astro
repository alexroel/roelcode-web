---
import { Icon } from "astro-icon/components";
import { techStacks } from "../../data/tech-stack";
import Badge from "../utils/Badge.astro";

// Duplicar las tecnologías para crear un loop infinito
const duplicatedTechs = [...techStacks, ...techStacks];
---

<section class="relative py-20 lg:py-28 bg-slate-900 overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0 bg-grid-futuristic opacity-10"></div>
  <div
    class="absolute top-1/2 left-0 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl -translate-y-1/2"
  >
  </div>
  <div
    class="absolute top-1/2 right-0 w-80 h-80 bg-violet-500/10 rounded-full blur-3xl -translate-y-1/2"
  >
  </div>

  <div class="relative container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center px-4 py-2 glass rounded-full text-sm font-medium mb-6 border border-emerald-500/30"
      >
        <Icon name="courses" class="w-4 h-4 text-emerald-400 mr-2" />
        <span class="text-emerald-300">Stack Tecnológico</span>
      </div>
      <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">
        Tecnologías que <span class="text-gradient-cyan">Domino</span>
      </h2>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">
        Las herramientas y frameworks que uso para crear aplicaciones modernas y
        que enseño a mis estudiantes.
      </p>
    </div>

    <!-- Slider Container -->
    <div class="relative">
      <div class="tech-slider-wrapper">
        <div class="tech-slider">
          {
            duplicatedTechs.map((tech, index) => (
              <div class="tech-item py-8" key={`${tech.name}-${index}`}>
                <Badge
                  variant="tech"
                  size="lg"
                  icon={tech.icon}
                  textColor={tech.textColor}
                  bgColor={tech.bgColor}
                  vertical={true}
                >
                  {tech.name}
                </Badge>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Fade gradients -->
      <div
        class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-slate-900 to-transparent pointer-events-none z-10"
      >
      </div>
      <div
        class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-slate-900 to-transparent pointer-events-none z-10"
      >
      </div>
    </div>
  </div>
</section>
