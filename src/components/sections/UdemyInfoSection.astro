---
import { Icon } from "astro-icon/components";
---

<section class="relative py-20 lg:py-28 bg-slate-900 overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0 bg-grid-futuristic opacity-10"></div>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-to-r from-violet-500/10 via-cyan-500/10 to-emerald-500/10 rounded-full blur-3xl"
  >
  </div>

  <div class="relative container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center gap-3 glass rounded-full px-6 py-3 border border-violet-500/30 mb-6"
        >
          <Icon name="udemy" class="w-8 h-8 text-violet-400" />
          <span class="text-xl font-bold text-white">Udemy</span>
        </div>
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">
          ¿Por qué elegir <span class="text-gradient-violet">Udemy</span>?
        </h2>
        <p class="text-lg text-slate-400 max-w-3xl mx-auto">
          Conoce todo sobre la plataforma líder en educación online que ha
          transformado la vida de millones de estudiantes en todo el mundo.
        </p>
      </div>

      <!-- Información principal -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
        <!-- Historia y datos -->
        <div
          class="glass-dark rounded-2xl p-8 border border-slate-700/50 hover:border-cyan-500/30 transition-colors"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-12 h-12 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-xl flex items-center justify-center glow-cyan"
            >
              <Icon name="courses" class="w-6 h-6 text-white" />
            </div>
            <h3 class="text-2xl font-bold text-white">Historia y Alcance</h3>
          </div>

          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-2 h-2 bg-cyan-500 rounded-full mt-2 flex-shrink-0">
              </div>
              <div>
                <p class="font-semibold text-white">Fundada en 2010</p>
                <p class="text-slate-400 text-sm">
                  Más de 13 años transformando la educación online
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-2 h-2 bg-emerald-500 rounded-full mt-2 flex-shrink-0"
              >
              </div>
              <div>
                <p class="font-semibold text-white">
                  57+ millones de estudiantes
                </p>
                <p class="text-slate-400 text-sm">
                  Comunidad global de aprendizaje activa
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-2 h-2 bg-violet-500 rounded-full mt-2 flex-shrink-0"
              >
              </div>
              <div>
                <p class="font-semibold text-white">213,000+ cursos</p>
                <p class="text-slate-400 text-sm">
                  En más de 2,000 temas diferentes
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-2 h-2 bg-pink-500 rounded-full mt-2 flex-shrink-0">
              </div>
              <div>
                <p class="font-semibold text-white">75+ idiomas</p>
                <p class="text-slate-400 text-sm">
                  Accesible para estudiantes de todo el mundo
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Seguridad y confianza -->
        <div
          class="glass-dark rounded-2xl p-8 border border-slate-700/50 hover:border-emerald-500/30 transition-colors"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-green-600 rounded-xl flex items-center justify-center glow-emerald"
            >
              <Icon name="check" class="w-6 h-6 text-white" />
            </div>
            <h3 class="text-2xl font-bold text-white">Seguridad y Confianza</h3>
          </div>

          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <Icon
                name="check"
                class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0"
              />
              <div>
                <p class="font-semibold text-white">Pagos seguros</p>
                <p class="text-slate-400 text-sm">
                  Encriptación SSL y procesamiento seguro de pagos
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <Icon
                name="check"
                class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0"
              />
              <div>
                <p class="font-semibold text-white">Instructores verificados</p>
                <p class="text-slate-400 text-sm">
                  Proceso de revisión y calidad de contenido
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <Icon
                name="check"
                class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0"
              />
              <div>
                <p class="font-semibold text-white">Certificados oficiales</p>
                <p class="text-slate-400 text-sm">
                  Certificados de finalización verificables
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <Icon
                name="check"
                class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0"
              />
              <div>
                <p class="font-semibold text-white">Soporte 24/7</p>
                <p class="text-slate-400 text-sm">
                  Atención al cliente en múltiples idiomas
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Política de reembolso y garantías -->
      <div class="relative rounded-2xl p-8 mb-16 overflow-hidden">
        <!-- Gradient Background -->
        <div
          class="absolute inset-0 bg-gradient-to-r from-cyan-600 via-violet-600 to-emerald-600"
        >
        </div>
        <div class="absolute inset-0 bg-grid-futuristic opacity-20"></div>

        <div class="relative max-w-4xl mx-auto">
          <div class="text-center mb-8">
            <Icon name="heart" class="w-12 h-12 mx-auto mb-4 text-white/90" />
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">
              Garantía de Satisfacción
            </h3>
            <p class="text-white/80 text-lg">
              Tu inversión está protegida con nuestra política de reembolso
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="text-center">
              <div class="glass rounded-xl p-6">
                <div class="text-4xl font-bold text-white mb-2">30</div>
                <div class="text-sm text-white/90">Días de garantía</div>
                <div class="text-xs text-white/70 mt-2">
                  Reembolso completo sin preguntas
                </div>
              </div>
            </div>

            <div class="text-center">
              <div class="glass rounded-xl p-6">
                <div class="text-4xl font-bold text-white mb-2">100%</div>
                <div class="text-sm text-white/90">Reembolso</div>
                <div class="text-xs text-white/70 mt-2">
                  Si no estás satisfecho
                </div>
              </div>
            </div>

            <div class="text-center">
              <div class="glass rounded-xl p-6">
                <div class="text-4xl font-bold text-white mb-2">∞</div>
                <div class="text-sm text-white/90">Acceso de por vida</div>
                <div class="text-xs text-white/70 mt-2">
                  Una vez comprado, siempre tuyo
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Características adicionales -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <div
          class="glass-dark rounded-xl p-6 text-center border border-slate-700/50 hover:border-amber-500/30 transition-colors card-3d"
        >
          <div
            class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <Icon name="star" class="w-6 h-6 text-white" />
          </div>
          <h4 class="font-bold text-white mb-2">Calidad Garantizada</h4>
          <p class="text-sm text-slate-400">
            Todos los cursos pasan por un proceso de revisión de calidad
          </p>
        </div>

        <div
          class="glass-dark rounded-xl p-6 text-center border border-slate-700/50 hover:border-cyan-500/30 transition-colors card-3d"
        >
          <div
            class="w-12 h-12 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <Icon name="courses" class="w-6 h-6 text-white" />
          </div>
          <h4 class="font-bold text-white mb-2">Aprende a tu ritmo</h4>
          <p class="text-sm text-slate-400">
            Acceso desde cualquier dispositivo, cuando quieras
          </p>
        </div>

        <div
          class="glass-dark rounded-xl p-6 text-center border border-slate-700/50 hover:border-emerald-500/30 transition-colors card-3d"
        >
          <div
            class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-green-600 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <Icon name="user" class="w-6 h-6 text-white" />
          </div>
          <h4 class="font-bold text-white mb-2">Comunidad activa</h4>
          <p class="text-sm text-slate-400">
            Interactúa con instructores y otros estudiantes
          </p>
        </div>

        <div
          class="glass-dark rounded-xl p-6 text-center border border-slate-700/50 hover:border-violet-500/30 transition-colors card-3d"
        >
          <div
            class="w-12 h-12 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <Icon name="check" class="w-6 h-6 text-white" />
          </div>
          <h4 class="font-bold text-white mb-2">Certificación</h4>
          <p class="text-sm text-slate-400">
            Obtén certificados al completar los cursos
          </p>
        </div>
      </div>

      <!-- CTA final -->
      <div class="text-center">
        <div
          class="glass-dark rounded-2xl p-8 border border-slate-700/50 inline-block"
        >
          <h3 class="text-2xl font-bold text-white mb-4">
            ¿Listo para comenzar tu aprendizaje?
          </h3>
          <p class="text-slate-400 mb-6">
            Únete a millones de estudiantes que ya están transformando sus
            carreras
          </p>
          <a
            href="/cursos"
            class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-cyan-500 to-emerald-500 text-white font-semibold rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/25 hover:scale-105"
          >
            <Icon name="courses" class="w-5 h-5" />
            Explorar Cursos
            <Icon name="arrow-right" class="w-5 h-5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
