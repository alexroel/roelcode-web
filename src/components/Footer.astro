---
import SocialLinks from "@/components/utils/SocialLinks.astro";
import { Icon } from "astro-icon/components";

import logoRC from "@/assets/logo-roelcode.svg";
import { Image } from "astro:assets";
---

<footer class="relative bg-slate-950 border-t border-slate-800 overflow-hidden">
  <!-- Background Effects -->
  <div
    class="absolute top-0 left-1/4 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-0 right-1/4 w-96 h-96 bg-violet-500/5 rounded-full blur-3xl"
  >
  </div>

  <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Logo y descripción -->
      <div class="md:col-span-2">
        <div class="flex items-center space-x-2 mb-6">
          <Image src={logoRC} alt="RoelCode" class="h-10 w-auto" />
          <span class="text-2xl font-bold text-gradient-cyan">RoelCode</span>
        </div>
        <p class="text-slate-400 mb-6 max-w-md leading-relaxed">
          Instructor de programación especializado en desarrollo web. Más de 8
          años de experiencia en tecnología y 4 años formando desarrolladores.
        </p>
        <SocialLinks variant="footer" />
      </div>

      <!-- Enlaces rápidos -->
      <div>
        <h3
          class="text-sm font-semibold text-white uppercase tracking-wider mb-6 flex items-center"
        >
          <div class="w-2 h-2 bg-cyan-500 rounded-full mr-3"></div>
          Navegación
        </h3>
        <ul class="space-y-4">
          <li>
            <a
              href="/"
              class="text-slate-400 hover:text-cyan-400 transition-colors flex items-center group"
            >
              <span
                class="w-0 group-hover:w-2 h-px bg-cyan-500 mr-0 group-hover:mr-2 transition-all"
              ></span>
              Inicio
            </a>
          </li>
          <li>
            <a
              href="/cursos"
              class="text-slate-400 hover:text-cyan-400 transition-colors flex items-center group"
            >
              <span
                class="w-0 group-hover:w-2 h-px bg-cyan-500 mr-0 group-hover:mr-2 transition-all"
              ></span>
              Cursos
            </a>
          </li>
          <li>
            <a
              href="/acerca-de"
              class="text-slate-400 hover:text-cyan-400 transition-colors flex items-center group"
            >
              <span
                class="w-0 group-hover:w-2 h-px bg-cyan-500 mr-0 group-hover:mr-2 transition-all"
              ></span>
              Acerca de
            </a>
          </li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3
          class="text-sm font-semibold text-white uppercase tracking-wider mb-6 flex items-center"
        >
          <div class="w-2 h-2 bg-emerald-500 rounded-full mr-3"></div>
          Recursos
        </h3>
        <ul class="space-y-4">
          <li>
            <a
              href="https://www.udemy.com/user/roel-code/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-emerald-400 transition-colors flex items-center space-x-3 group"
            >
              <Icon name="udemy" class="h-5 w-5 text-violet-500" />
              <span>Cursos en Udemy</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/@AlexRoelCode"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-emerald-400 transition-colors flex items-center space-x-3 group"
            >
              <Icon name="youtube" class="h-5 w-5 text-red-500" />
              <span>Tutoriales gratuitos</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/alexroel"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-emerald-400 transition-colors flex items-center space-x-3 group"
            >
              <Icon name="github" class="h-5 w-5 text-slate-300" />
              <span>Código fuente</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Decorative Line -->
    <div class="flex items-center justify-center my-12">
      <div class="h-px flex-1 bg-gradient-to-r from-transparent to-slate-700">
      </div>
      <div class="w-3 h-3 rounded-full bg-cyan-500 mx-4 animate-pulse"></div>
      <div class="h-px flex-1 bg-gradient-to-l from-transparent to-slate-700">
      </div>
    </div>

    <!-- Copyright -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-slate-500 text-sm">
        © {new Date().getFullYear()} RoelCode. Casi todos los derechos reservados.
      </p>
      <p class="text-slate-500 text-sm flex items-center gap-2">
        Hecho con
        <span class="text-red-500 animate-pulse">❤️</span>
        y
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cyan-400 hover:text-cyan-300 transition-colors"
        >
          Astro
        </a>
      </p>
    </div>
  </div>
</footer>
