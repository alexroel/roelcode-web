---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { UdemyCourse } from "../../data/udemy-courses";

export interface Props {
  course: UdemyCourse;
}

const { course } = Astro.props;
---

<div
  class="course-card glass-dark rounded-2xl overflow-hidden border border-slate-700/50 hover:border-cyan-500/30 transition-all duration-300 h-full flex flex-col card-3d"
>
  <div class="relative">
    <Image
      src={course.image}
      alt={course.title}
      class="w-full h-48 object-cover"
    />

    <!-- Gradient Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-slate-900/80 to-transparent"
    >
    </div>

    <!-- Badges -->
    <div class="absolute top-4 left-4 flex gap-2">
      {
        course.popular && (
          <span class="bg-gradient-to-r from-amber-500 to-orange-500 text-white px-3 py-1 rounded-full text-xs font-medium shadow-lg flex items-center gap-1">
            <Icon name="star" class="w-3 h-3" />
            Popular
          </span>
        )
      }
      {
        course.newCourse && (
          <span class="bg-gradient-to-r from-emerald-500 to-green-500 text-white px-3 py-1 rounded-full text-xs font-medium shadow-lg flex items-center gap-1">
            <Icon name="check" class="w-3 h-3" />
            Nuevo
          </span>
        )
      }
    </div>

    <!-- Rating overlay -->
    <div
      class="absolute top-4 right-4 glass-dark px-3 py-1.5 rounded-lg text-sm flex items-center gap-1"
    >
      <Icon name="star" class="w-4 h-4 text-amber-400" />
      <span class="text-white font-semibold">{course.rating.toFixed(1)}</span>
    </div>
  </div>

  <div class="p-6 flex-1 flex flex-col">
    <!-- Title and Description -->
    <h3 class="text-xl font-bold text-white mb-2 line-clamp-2">
      {course.title}
    </h3>
    <p class="text-slate-400 mb-4 line-clamp-3 flex-1">
      {course.headline}
    </p>

    <div class="flex justify-between items-center mb-4">
      <!-- Rating and Reviews -->
      <div class="flex items-center gap-2">
        <div class="flex items-center">
          {
            Array.from({ length: 5 }, (_, i) => (
              <Icon
                name={i < Math.floor(course.rating) ? "star" : "star-half"}
                class="w-4 h-4 text-amber-400"
              />
            ))
          }
        </div>
        <span class="text-sm text-slate-500">
          ({course.numReviews.toLocaleString()})
        </span>
      </div>

      <!-- Course Info -->
      <div class="flex items-center gap-3 text-sm text-slate-400">
        <span class="flex items-center gap-1">
          <Icon name="courses" class="w-4 h-4 text-cyan-400" />
          {course.numClass}
        </span>
        <span class="flex items-center gap-1">
          <Icon name="instructor" class="w-4 h-4 text-emerald-400" />
          {course.hours}h
        </span>
      </div>
    </div>

    <!-- Separator -->
    <div class="h-px bg-slate-700/50 mb-4"></div>

    <!-- Price and CTA -->
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        {
          course.priceDiscount && (
            <span class="text-2xl font-bold text-gradient-cyan">
              ${course.priceDiscount}
            </span>
          )
        }
        <span
          class={`${course.priceDiscount ? "line-through text-slate-500 text-lg" : "text-2xl font-bold text-white"}`}
        >
          ${course.price}
        </span>
      </div>
      <a
        href={course.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-cyan-500 to-emerald-500 text-white text-sm font-semibold rounded-lg transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/25 hover:scale-105"
      >
        <Icon name="udemy" class="w-4 h-4" />
        Ver Curso
      </a>
    </div>
  </div>
</div>

<style>
  .course-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
