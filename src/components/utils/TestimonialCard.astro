---
import { Icon } from "astro-icon/components";

export interface Props {
  name: string;
  description: string;
  calification: number;
  userIcon?: string;
  iconQuote?: string;
  class?: string;
}

const {
  name,
  description,
  calification,
  userIcon = "user",
  iconQuote = "quote",
  class: className = "",
} = Astro.props;

// Generar estrellas basadas en la calificación
const stars = Array.from({ length: 5 }, (_, i) => i < calification);
---

<div
  class={`glass-dark rounded-2xl p-6 border border-slate-700/50 hover:border-cyan-500/30 transition-all duration-300 card-3d ${className}`}
>
  <!-- Quote Icon -->
  <div class="flex justify-start mb-4">
    <div
      class="w-10 h-10 bg-gradient-to-br from-cyan-500/20 to-cyan-500/5 rounded-xl flex items-center justify-center border border-cyan-500/30"
    >
      <Icon name={iconQuote} class="h-5 w-5 text-cyan-400" />
    </div>
  </div>

  <!-- Testimonial Text -->
  <blockquote class="text-slate-300 mb-6 leading-relaxed">
    "{description}"
  </blockquote>

  <!-- Rating Stars -->
  <div class="flex items-center mb-4 gap-1">
    {
      stars.map((filled) => (
        <Icon
          name="star"
          class={`h-4 w-4 ${filled ? "text-amber-400" : "text-slate-600"}`}
        />
      ))
    }
  </div>

  <!-- Separator -->
  <div class="h-px bg-slate-700/50 mb-4"></div>

  <!-- User Info -->
  <div class="flex items-center">
    <div
      class="w-10 h-10 bg-gradient-to-br from-violet-500/20 to-violet-500/5 rounded-xl flex items-center justify-center mr-3 border border-violet-500/30"
    >
      <Icon name={userIcon} class="h-5 w-5 text-violet-400" />
    </div>
    <div>
      <div class="font-semibold text-white">
        {name}
      </div>
      <div class="text-sm text-slate-500">Estudiante de Udemy</div>
    </div>
  </div>
</div>
