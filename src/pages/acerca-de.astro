---
import StatsSection from "@/components/sections/StatsSection.astro";
import TechStackSection from "@/components/sections/TechStackSection.astro";
import { socialLinks } from "@/data/social-links";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const pageTitle = "Acerca de Mí | Roel Code";
const pageDescription =
  "Conoce más sobre mi experiencia como instructor de programación, mis especialidades en desarrollo web y mi filosofía de enseñanza.";

// Schema markup para la página acerca de
const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  dateCreated: "2024-01-01",
  dateModified: new Date().toISOString(),
  mainEntity: {
    "@type": "Person",
    name: "Roel Code",
    jobTitle: "Desarrollador Full Stack & Instructor",
    description:
      "Desarrollador Full Stack con más de 8 años de experiencia especializado en tecnologías web modernas y educación en programación.",
    knowsAbout: [
      "JavaScript",
      "Python",
      "Go",
      "Java",
      "HTML",
      "CSS",
      "React",
      "Node.js",
      "Flask",
      "TailwindCSS",
    ],
    hasOccupation: {
      "@type": "Occupation",
      name: "Instructor de Programación",
      occupationLocation: {
        "@type": "Place",
        name: "Online",
      },
      skills:
        "Desarrollo Web, Programación, Enseñanza Online, Creación de Cursos",
      experienceRequirements: "8+ años de experiencia",
    },
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "Autodidacta en Programación",
    },
    award: [
      "Instructor destacado en Udemy",
      "Más de 180K estudiantes formados",
      "Promedio de 4.6 estrellas en cursos",
    ],
    memberOf: {
      "@type": "Organization",
      name: "Udemy Instructor Community",
    },
  },
};

// Schema para habilidades profesionales
const skillsSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Habilidades Técnicas de Roel Code",
  itemListElement: [
    {
      "@type": "DefinedTerm",
      name: "JavaScript",
      description: "Lenguaje de programación para desarrollo web",
    },
    {
      "@type": "DefinedTerm",
      name: "Python",
      description: "Lenguaje de programación versátil",
    },
    {
      "@type": "DefinedTerm",
      name: "Go",
      description: "Lenguaje de programación de Google",
    },
    {
      "@type": "DefinedTerm",
      name: "Java",
      description: "Lenguaje de programación orientado a objetos",
    },
  ],
};

import AlexAvatar from "@/assets/images/alex-avatar.png";
import { Image } from "astro:assets";
---

<Layout
  title="Acerca de Roel Code | Desarrollador Full Stack & Instructor"
  description="Conoce la historia de Roel Code, desarrollador Full Stack con más de 8 años de experiencia y instructor especializado en tecnologías web modernas."
  type="profile"
  schema={[aboutSchema, skillsSchema]}
  keywords="Roel Code, desarrollador, instructor, programación, experiencia, biografía, full stack"
  author="Roel Code"
>
  <!-- Hero Section - Futuristic -->
  <section
    class="relative min-h-screen bg-gradient-animate overflow-hidden py-16 lg:py-24"
  >
    <!-- Grid Pattern Overlay -->
    <div class="absolute inset-0 bg-grid-futuristic opacity-30"></div>

    <!-- Floating Decorative Elements -->
    <div
      class="absolute top-20 left-10 w-32 h-32 bg-cyan-500/20 rounded-full blur-3xl animate-float"
    >
    </div>
    <div
      class="absolute bottom-20 right-10 w-40 h-40 bg-violet-500/20 rounded-full blur-3xl animate-float-delayed"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/4 w-24 h-24 bg-emerald-500/20 rounded-full blur-2xl animate-float-slow"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center min-h-[70vh]">
        <!-- Content -->
        <div>
          <!-- Badge -->
          <div
            class="inline-flex items-center px-4 py-2 glass rounded-full text-sm font-medium mb-6 border border-cyan-500/30"
          >
            <div class="w-2 h-2 bg-cyan-400 rounded-full mr-3 animate-pulse">
            </div>
            <span class="text-cyan-300">Instructor & Desarrollador</span>
          </div>

          <!-- Title -->
          <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
            Hola, soy
            <span class="text-gradient-cyan block mt-2"> Alex Roel </span>
          </h1>

          <!-- Description -->
          <p class="text-xl text-slate-300 mb-8 leading-relaxed max-w-xl">
            Instructor de programación apasionado por enseñar y compartir
            conocimiento. Con más de
            <span class="text-cyan-400 font-semibold"
              >8 años de experiencia</span
            >
            en tecnología y
            <span class="text-emerald-400 font-semibold"
              >4 años formando desarrolladores</span
            >.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/cursos"
              class="group inline-flex items-center px-8 py-4 bg-gradient-to-r from-cyan-500 to-emerald-500 text-white font-semibold rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/25 hover:scale-105"
            >
              Ver Mis Cursos
              <Icon
                name="arrow-right"
                class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform"
              />
            </a>
          </div>
        </div>

        <!-- Profile Image with Futuristic Frame -->
        <div class="relative flex justify-center">
          <!-- Outer Glow Ring -->
          <div
            class="absolute inset-0 flex items-center justify-center animate-glow-pulse"
          >
            <div
              class="w-80 h-80 rounded-full bg-gradient-to-r from-cyan-500/20 to-violet-500/20 blur-xl"
            >
            </div>
          </div>

          <!-- Profile Container -->
          <div class="relative">
            <!-- Rotating Border -->
            <div
              class="absolute -inset-3 bg-gradient-to-r from-cyan-500 via-emerald-500 to-violet-500 rounded-full opacity-75 blur-sm animate-spin"
              style="animation-duration: 8s;"
            >
            </div>

            <!-- Image Frame -->
            <div
              class="relative w-72 h-72 lg:w-80 lg:h-80 rounded-full p-1 bg-gradient-to-r from-cyan-500 via-emerald-500 to-violet-500"
            >
              <div
                class="w-full h-full rounded-full bg-slate-900 p-2 flex items-center justify-center"
              >
                <Image
                  src={AlexAvatar}
                  alt="Roel Code Avatar"
                  class="w-full h-full rounded-full object-cover"
                />
              </div>
            </div>

            <!-- Floating Tech Icons -->
            <div
              class="absolute -top-4 -right-4 w-16 h-16 glass-dark rounded-xl flex items-center justify-center animate-float border border-cyan-500/30"
            >
              <Icon name="tech/python" class="w-8 h-8 text-cyan-400" />
            </div>
            <div
              class="absolute -bottom-4 -left-4 w-16 h-16 glass-dark rounded-xl flex items-center justify-center animate-float-delayed border border-emerald-500/30"
            >
              <Icon name="tech/golang" class="w-8 h-8 text-emerald-400" />
            </div>
            <div
              class="absolute top-1/2 -left-10 w-14 h-14 glass-dark rounded-xl flex items-center justify-center animate-float-slow border border-violet-500/30"
            >
              <Icon name="tech/javascript" class="w-7 h-7 text-yellow-400" />
            </div>
            <div
              class="absolute top-1/3 -right-8 w-12 h-12 glass-dark rounded-xl flex items-center justify-center animate-float border border-pink-500/30"
            >
              <Icon name="tech/html" class="w-6 h-6 text-orange-400" />
            </div>
          </div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
        <div class="flex flex-col items-center text-slate-400">
          <span class="text-sm mb-2">Descubre más</span>
          <div
            class="w-6 h-10 border-2 border-slate-400/50 rounded-full flex justify-center pt-2"
          >
            <div class="w-1.5 h-3 bg-cyan-400 rounded-full animate-bounce">
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Biography Section - Futuristic -->
  <section class="relative py-20 lg:py-32 bg-slate-950 overflow-hidden">
    <!-- Background Elements -->
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-80 h-80 bg-violet-500/5 rounded-full blur-3xl"
    >
    </div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center px-4 py-2 glass rounded-full text-sm font-medium mb-6 border border-violet-500/30"
        >
          <Icon name="user" class="w-4 h-4 text-violet-400 mr-2" />
          <span class="text-violet-300">Mi Trayectoria</span>
        </div>
        <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4">
          Mi <span class="text-gradient-violet">Historia</span>
        </h2>
        <p class="text-lg text-slate-400 max-w-2xl mx-auto">
          Un viaje de aprendizaje continuo y pasión por la enseñanza
        </p>
      </div>

      <!-- Biography Cards -->
      <div class="grid md:grid-cols-3 gap-6">
        <div class="glass-dark rounded-2xl p-8 border-glow card-3d">
          <div
            class="w-14 h-14 bg-gradient-to-br from-cyan-500/20 to-cyan-500/5 rounded-xl flex items-center justify-center mb-6 border border-cyan-500/30"
          >
            <Icon name="courses" class="w-7 h-7 text-cyan-400" />
          </div>
          <h3 class="text-xl font-bold text-white mb-4">
            Pasión por el Código
          </h3>
          <p class="text-slate-400 leading-relaxed">
            Mi pasión por la programación comenzó hace más de 8 años, cuando
            descubrí el poder de crear soluciones tecnológicas que pueden
            impactar positivamente la vida de las personas.
          </p>
        </div>

        <div class="glass-dark rounded-2xl p-8 border-glow card-3d">
          <div
            class="w-14 h-14 bg-gradient-to-br from-emerald-500/20 to-emerald-500/5 rounded-xl flex items-center justify-center mb-6 border border-emerald-500/30"
          >
            <Icon name="instructor" class="w-7 h-7 text-emerald-400" />
          </div>
          <h3 class="text-xl font-bold text-white mb-4">+180K Estudiantes</h3>
          <p class="text-slate-400 leading-relaxed">
            Como instructor, he tenido el privilegio de formar a más de 180,000
            estudiantes a través de mis cursos en Udemy, haciendo conceptos
            complejos accesibles.
          </p>
        </div>

        <div class="glass-dark rounded-2xl p-8 border-glow card-3d">
          <div
            class="w-14 h-14 bg-gradient-to-br from-violet-500/20 to-violet-500/5 rounded-xl flex items-center justify-center mb-6 border border-violet-500/30"
          >
            <Icon name="star" class="w-7 h-7 text-violet-400" />
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Proyectos Reales</h3>
          <p class="text-slate-400 leading-relaxed">
            Creo firmemente que la mejor manera de aprender programación es a
            través de la práctica constante y proyectos que resuelvan problemas
            reales.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience Stats Section -->
  <StatsSection />

  <!-- Technologies Section -->
  <TechStackSection />

  <!-- Specialties Section - Futuristic -->
  <section class="relative py-20 lg:py-32 bg-slate-950 overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 bg-grid-futuristic opacity-20"></div>
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-to-r from-cyan-500/10 via-violet-500/10 to-emerald-500/10 rounded-full blur-3xl"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center px-4 py-2 glass rounded-full text-sm font-medium mb-6 border border-emerald-500/30"
        >
          <Icon name="star" class="w-4 h-4 text-emerald-400 mr-2" />
          <span class="text-emerald-300">Áreas de Expertise</span>
        </div>
        <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4">
          Mis <span class="text-gradient-cyan">Especialidades</span>
        </h2>
        <p class="text-lg text-slate-400 max-w-2xl mx-auto">
          Áreas donde puedo ayudarte a crecer profesionalmente
        </p>
      </div>

      <!-- Specialty Cards -->
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Frontend Development -->
        <div
          class="group glass-dark rounded-2xl p-8 border border-slate-700/50 hover:border-cyan-500/50 transition-all duration-500 card-3d"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 glow-cyan"
          >
            <Icon name="tech/html" class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">
            Frontend Development
          </h3>
          <p class="text-slate-400 mb-6">
            Creación de interfaces modernas y responsivas con HTML, CSS,
            JavaScript y frameworks modernos.
          </p>
          <ul class="space-y-3">
            {
              [
                "HTML5 & CSS3",
                "JavaScript ES6+",
                "Responsive Design",
                "Tailwind CSS",
                "Astro",
              ].map((skill) => (
                <li class="flex items-center text-slate-300">
                  <div class="w-2 h-2 bg-cyan-400 rounded-full mr-3" />
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Backend Development -->
        <div
          class="group glass-dark rounded-2xl p-8 border border-slate-700/50 hover:border-emerald-500/50 transition-all duration-500 card-3d"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-green-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 glow-emerald"
          >
            <Icon name="tech/python" class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">
            Backend Development
          </h3>
          <p class="text-slate-400 mb-6">
            Desarrollo de APIs robustas y aplicaciones del lado del servidor con
            múltiples tecnologías.
          </p>
          <ul class="space-y-3">
            {
              [
                "Python (Flask & Django)",
                "Go (Golang)",
                "Java",
                "APIs RESTful",
                "JavaScript (Express)",
              ].map((skill) => (
                <li class="flex items-center text-slate-300">
                  <div class="w-2 h-2 bg-emerald-400 rounded-full mr-3" />
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Other Technologies -->
        <div
          class="group glass-dark rounded-2xl p-8 border border-slate-700/50 hover:border-violet-500/50 transition-all duration-500 card-3d"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-violet-500 to-purple-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 glow-violet"
          >
            <Icon name="courses" class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">Otras Tecnologías</h3>
          <p class="text-slate-400 mb-6">
            Herramientas adicionales que complementan el desarrollo full-stack
            moderno.
          </p>
          <ul class="space-y-3">
            {
              [
                "Bases de Datos",
                "Git & GitHub",
                "Docker",
                "Linux/Terminal",
              ].map((skill) => (
                <li class="flex items-center text-slate-300">
                  <div class="w-2 h-2 bg-violet-400 rounded-full mr-3" />
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy Section - Futuristic -->
  <section class="relative py-20 lg:py-32 bg-slate-900 overflow-hidden">
    <!-- Background -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950"
    >
    </div>
    <div
      class="absolute top-0 left-1/4 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-0 right-1/4 w-72 h-72 bg-violet-500/10 rounded-full blur-3xl"
    >
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center px-4 py-2 glass rounded-full text-sm font-medium mb-6 border border-cyan-500/30"
        >
          <Icon name="star" class="w-4 h-4 text-cyan-400 mr-2" />
          <span class="text-cyan-300">Principios</span>
        </div>
        <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4">
          Mi Filosofía de
          <span class="text-gradient-cyan">Enseñanza</span>
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Philosophy Points -->
        <div class="space-y-8">
          <div
            class="flex items-start gap-6 glass-dark rounded-2xl p-6 border border-slate-700/50 hover:border-cyan-500/30 transition-colors"
          >
            <div
              class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-xl flex items-center justify-center text-white font-bold text-lg"
            >
              1
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">
                Aprendizaje Práctico
              </h3>
              <p class="text-slate-400">
                Creo firmemente en aprender haciendo. Todos mis cursos incluyen
                proyectos reales que puedes agregar a tu portafolio.
              </p>
            </div>
          </div>

          <div
            class="flex items-start gap-6 glass-dark rounded-2xl p-6 border border-slate-700/50 hover:border-emerald-500/30 transition-colors"
          >
            <div
              class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-emerald-500 to-green-600 rounded-xl flex items-center justify-center text-white font-bold text-lg"
            >
              2
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">Desde Cero</h3>
              <p class="text-slate-400">
                No importa tu nivel actual, mis cursos están diseñados para
                llevarte desde los fundamentos hasta el nivel profesional.
              </p>
            </div>
          </div>

          <div
            class="flex items-start gap-6 glass-dark rounded-2xl p-6 border border-slate-700/50 hover:border-violet-500/30 transition-colors"
          >
            <div
              class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-lg"
            >
              3
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">
                Soporte Continuo
              </h3>
              <p class="text-slate-400">
                Estoy aquí para ayudarte en tu journey. Respondo dudas y
                proporciono feedback personalizado a mis estudiantes.
              </p>
            </div>
          </div>
        </div>

        <!-- Quote Card -->
        <div class="relative">
          <!-- Decorative glow -->
          <div
            class="absolute -inset-4 bg-gradient-to-r from-cyan-500/20 via-violet-500/20 to-emerald-500/20 rounded-3xl blur-xl"
          >
          </div>

          <div
            class="relative glass-dark rounded-3xl p-10 border border-slate-700/50"
          >
            <Icon name="quote" class="w-12 h-12 text-cyan-500/50 mb-6" />
            <blockquote class="text-xl text-slate-300 leading-relaxed mb-8">
              "La programación no es solo escribir código, es resolver problemas
              y crear soluciones que impacten positivamente en el mundo. Mi
              objetivo es enseñarte no solo la sintaxis, sino también a
              <span class="text-cyan-400 font-semibold"
                >pensar como un desarrollador</span
              >."
            </blockquote>
            <div class="flex items-center gap-4">
              <div
                class="w-14 h-14 rounded-full p-0.5 bg-gradient-to-r from-cyan-500 to-emerald-500"
              >
                <Image
                  src={AlexAvatar}
                  alt="Roel Code Avatar"
                  class="w-full h-full rounded-full object-cover"
                />
              </div>
              <div>
                <div class="font-semibold text-white text-lg">Alex Roel</div>
                <div class="text-slate-400">Instructor & Desarrollador</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Links Section - Futuristic -->
  <section class="relative py-20 lg:py-24 overflow-hidden">
    <!-- Animated Gradient Background -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-slate-950 via-cyan-950/50 to-slate-950"
    >
    </div>
    <div class="absolute inset-0 bg-grid-futuristic opacity-20"></div>

    <!-- Glow effects -->
    <div
      class="absolute top-0 left-1/3 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-0 right-1/3 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl"
    >
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Header -->
      <div
        class="inline-flex items-center px-4 py-2 glass rounded-full text-sm font-medium mb-6 border border-cyan-500/30"
      >
        <Icon name="heart-line" class="w-4 h-4 text-cyan-400 mr-2" />
        <span class="text-cyan-300">Redes Sociales</span>
      </div>

      <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4">
        Conecta <span class="text-gradient-cyan">Conmigo</span>
      </h2>
      <p class="text-xl text-slate-400 mb-12 max-w-2xl mx-auto">
        Sígueme en mis redes sociales para contenido educativo y actualizaciones
      </p>

      <!-- Social Links Grid -->
      <div class="flex flex-wrap justify-center gap-4">
        {
          socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group glass-dark px-8 py-4 rounded-xl border border-slate-700/50 hover:border-cyan-500/50 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-cyan-500/20 flex items-center gap-3"
            >
              <Icon
                name={social.icon}
                class="w-6 h-6 text-slate-400 group-hover:text-cyan-400 transition-colors"
              />
              <span class="text-slate-300 group-hover:text-white font-medium transition-colors">
                {social.name}
              </span>
            </a>
          ))
        }
      </div>

      <!-- Decorative Line -->
      <div class="mt-16 flex items-center justify-center">
        <div class="h-px w-24 bg-gradient-to-r from-transparent to-cyan-500/50">
        </div>
        <div class="w-3 h-3 rounded-full bg-cyan-500 mx-4 animate-pulse"></div>
        <div class="h-px w-24 bg-gradient-to-l from-transparent to-cyan-500/50">
        </div>
      </div>
    </div>
  </section>
</Layout>
