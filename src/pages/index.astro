---
import UdemyInfoSection from "@/components/sections/UdemyInfoSection.astro";
import { Icon } from "astro-icon/components";
import CoursesPreviewSection from "../components/sections/CoursesPreviewSection.astro";
import StatsSection from "../components/sections/StatsSection.astro";
import TechStackSection from "../components/sections/TechStackSection.astro";
import TestimonialGrid from "../components/sections/TestimonialGrid.astro";
import Layout from "../layouts/Layout.astro";

// Schema markup para la página principal
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Roel Code",
  url: "https://roelcode.github.io",
  description:
    "Instructor de programación especializado en desarrollo web. Cursos de HTML, CSS, JavaScript, Python, Go, Java y más.",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://roelcode.github.io/cursos?search={search_term_string}",
    "query-input": "required name=search_term_string",
  },
  author: {
    "@type": "Person",
    name: "Roel Code",
    jobTitle: "Desarrollador Full Stack & Instructor",
    url: "https://roelcode.github.io/acerca-de",
  },
  mainEntity: {
    "@type": "EducationalOrganization",
    name: "Roel Code Academy",
    description:
      "Plataforma educativa especializada en programación y desarrollo web",
    hasCredential: {
      "@type": "EducationalOccupationalCredential",
      name: "Certificados de Programación",
      credentialCategory: "certificate",
    },
  },
};

// Schema para organización
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: "Roel Code",
  url: "https://roelcode.github.io",
  logo: "https://roelcode.github.io/favicon.svg",
  description: "Instructor de programación con más de 8 años de experiencia",
  founder: {
    "@type": "Person",
    name: "Roel Code",
  },
  numberOfEmployees: 1,
  foundingDate: "2016",
  areaServed: "Worldwide",
  serviceType: "Educación en Programación",
};
---

<Layout
  title="Roelcode | Desarrollador Full Stack & Instructor"
  schema={[homeSchema, organizationSchema]}
  keywords="Roel Code, programación, desarrollo web, instructor, cursos online, JavaScript, Python, Go, Java"
  type="website"
>
  <main>
    <!-- Hero Section - Futuristic -->
    <section
      class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-animate"
    >
      <!-- Grid Pattern -->
      <div class="absolute inset-0 bg-grid-futuristic opacity-30"></div>

      <!-- Floating Orbs -->
      <div
        class="absolute top-20 left-10 w-72 h-72 bg-cyan-500/20 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-20 right-10 w-80 h-80 bg-violet-500/20 rounded-full blur-3xl animate-float-delayed"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl animate-float-slow"
      >
      </div>

      <div class="container mx-auto px-4 py-20 relative z-10">
        <div class="max-w-5xl mx-auto text-center">
          <!-- Badge -->
          <div
            class="inline-flex items-center gap-3 glass rounded-full px-5 py-2.5 mb-8 border border-cyan-500/30"
          >
            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse">
            </div>
            <span class="text-sm font-medium text-slate-300"
              >Disponible para proyectos</span
            >
          </div>

          <!-- Title -->
          <div class="mb-8 space-y-4">
            <h1
              class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight"
            >
              Hola, Bienvenido a
              <span class="text-gradient-cyan block mt-2"> Roelcode.com </span>
            </h1>
          </div>

          <!-- Description -->
          <div class="max-w-3xl mx-auto mb-12">
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
              Descubre mis cursos de
              <span class="text-cyan-400 font-semibold">Udemy</span>, tutoriales
              en
              <span class="text-red-400 font-semibold">YouTube</span>
              y contenido exclusivo. Conviértete en un
              <span class="text-emerald-400 font-semibold"
                >experto en programación</span
              >
              con recursos creados especialmente para ti.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
            <a
              href="/cursos"
              class="group inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-cyan-500 to-emerald-500 text-white font-semibold rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/25 hover:scale-105"
            >
              <Icon name="courses" class="w-5 h-5 mr-2" />
              Explorar Cursos
              <Icon
                name="arrow-right"
                class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform"
              />
            </a>
            <a
              href="/acerca-de"
              class="group inline-flex items-center justify-center px-8 py-4 glass border border-slate-600 hover:border-cyan-500/50 text-white font-semibold rounded-xl transition-all duration-300 hover:bg-white/5"
            >
              <Icon name="user" class="w-5 h-5 mr-2" />
              Conoce mi Historia
            </a>
          </div>

          <!-- Stats Cards -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto">
            <div class="glass-dark rounded-2xl p-6 border border-slate-700/50">
              <div class="text-3xl font-bold text-gradient-cyan mb-2">8+</div>
              <div class="text-sm text-slate-400">Cursos disponibles</div>
            </div>
            <div class="glass-dark rounded-2xl p-6 border border-slate-700/50">
              <div class="text-3xl font-bold text-gradient-cyan mb-2">
                180K+
              </div>
              <div class="text-sm text-slate-400">Estudiantes en Udemy</div>
            </div>
            <div class="glass-dark rounded-2xl p-6 border border-slate-700/50">
              <div class="text-3xl font-bold text-gradient-cyan mb-2">8+</div>
              <div class="text-sm text-slate-400">Años de Experiencia</div>
            </div>
          </div>

          <!-- Scroll Indicator -->
          <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
            <div class="flex flex-col items-center text-slate-400">
              <span class="text-sm mb-2">Descubre más</span>
              <div
                class="w-6 h-10 border-2 border-slate-500/50 rounded-full flex justify-center pt-2"
              >
                <div class="w-1.5 h-3 bg-cyan-400 rounded-full animate-bounce">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <StatsSection />

    <!-- Tech Stack Section -->
    <TechStackSection />

    <!-- Courses Preview Section -->
    <CoursesPreviewSection />

    <!-- Testimonials Section -->
    <TestimonialGrid />

    <!-- Info de Udemy -->
    <UdemyInfoSection />
  </main>
</Layout>
